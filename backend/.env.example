# ─── ORBIT proxy backend configuration ──────────────────────────────────────
# Copy this file to `.env` and fill it in. Never commit the real `.env`.

# Port the server listens on.
PORT=8080

# Shared access token the ORBIT frontend must send with every proxy request.
# Generate a long random value, e.g.:  openssl rand -hex 32
# Put the SAME value into ORBIT → Settings → Browser backend → Access token.
# If left empty the proxy runs OPEN (no auth) — only for local testing.
ACCESS_TOKEN=

# Comma-separated list of web origins allowed to call /healthz from the browser.
# Use your GitHub Pages origin, e.g. https://yourname.github.io
# "*" allows any origin (fine for /healthz, which returns no private data).
ALLOWED_ORIGINS=*

# Safety limits.
REQUEST_TIMEOUT_MS=15000        # abort upstream fetch after this long
MAX_CONTENT_BYTES=8000000       # refuse responses larger than this (8 MB)
MAX_REDIRECTS=5                 # follow at most this many redirects (each re-checked)

# SSRF protection. Keep this "true" in production: it blocks requests to
# private, loopback, link-local and reserved IP ranges (e.g. cloud metadata).
BLOCK_PRIVATE_IPS=true
